# Copy this to .env and change what you need. Docker Compose reads .env automatically,
# and everything here has a default that works for local use.

# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
# Turn these on when the site is served over HTTPS.
DJANGO_SECURE_COOKIES=false
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_BEHIND_TLS_PROXY=false
LOG_LEVEL=INFO

# Database. Set DB_ENGINE=sqlite to skip Postgres for a quick local run.
DB_ENGINE=postgres
POSTGRES_DB=fuel_routes
POSTGRES_USER=fuel_routes
POSTGRES_PASSWORD=replace-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Cache. Leave REDIS_URL empty to use an in-memory cache instead.
REDIS_URL=redis://localhost:6379/0
GEOCODE_CACHE_TTL_SECONDS=2592000
GEOCODE_NEGATIVE_CACHE_TTL_SECONDS=3600
ROUTE_CACHE_TTL_SECONDS=86400

# OSRM and Nominatim. The public servers are fine for light use; point these at your own for more.
OSRM_BASE_URL=https://router.project-osrm.org
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=fuel-route-optimizer/1.0 (backend assessment)
# Optional. Nominatim likes a contact address from regular users.
NOMINATIM_EMAIL=
# Keep this at 1 or more on the public Nominatim server.
NOMINATIM_MIN_INTERVAL_SECONDS=1.0
EXTERNAL_API_TIMEOUT_SECONDS=10

# Fuel planning
VEHICLE_MAX_RANGE_MILES=500
VEHICLE_MPG=10
FUEL_STATION_ROUTE_CORRIDOR_MILES=10
# How much fuel money a stop has to save to be worth making. 0 = cheapest plan, however many stops.
FUEL_STOP_PENALTY_DOLLARS=5

# API
API_ANON_THROTTLE_RATE=60/minute
# Docker only: import the CSV and load coordinates when the container starts.
LOAD_FUEL_DATA_ON_START=true
